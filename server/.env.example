# Server
PORT=3001

# Shopify app credentials
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_app_secret
SHOPIFY_SCOPES=read_products,write_products,read_discounts,write_discounts
SHOPIFY_APP_URL=https://your-public-app-url
FRONTEND_URL=https://your-public-app-url
TOKEN_STORE_PATH=./data/installed-shops.json
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_or_raw_32_chars
